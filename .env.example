# Supabase project (same backend as the BreakQ app)
VITE_SUPABASE_URL=https://psanmbsimwxpperizsxe.supabase.co
VITE_SUPABASE_ANON_KEY=

# ^ Use the SAME anon key that's baked into the app's .env — it's safe to
# reuse client-side, RLS is what actually enforces access. Never put the
# service_role key, Firebase service account key, or Razorpay secret in
# this file or any VITE_ variable — those must never reach the browser.

# Shared password for the /admin page gate (a pre-filter shown before the
# email login — NOT the real auth, which is profiles.role = 'admin').
# Optional: defaults to "breakq-admin" if unset.
VITE_ADMIN_GATE_PASSWORD=

# ── Supabase Edge Function secrets (server-side only — set via
#    Dashboard → Edge Functions → Manage secrets, NOT in this file) ──
#   RESEND_API_KEY        Resend API key, shared by every mailer function
#   FROM_EMAIL            Resend-verified sender, e.g. noreply@breakq.app
#   CONTACT_NOTIFY_EMAIL  where the Contact Us form sends messages
#                         (falls back to PARTNER_NOTIFY_EMAIL, then ADMIN_EMAIL)
#   PARTNER_NOTIFY_EMAIL  where "Become a partner" applications are emailed
